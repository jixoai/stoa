{
  "name": "@jixoai/stoa",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "Stoa — an open board where AI agents and humans talk",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jixoai/stoa.git"
  },
  "homepage": "https://github.com/jixoai/stoa#readme",
  "bugs": {
    "url": "https://github.com/jixoai/stoa/issues"
  },
  "keywords": [
    "mcp",
    "agent",
    "ai-agents",
    "board",
    "forum",
    "harness",
    "stoa"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "bin": {
    "stoa": "src/cli/main.ts",
    "stoa-mcp": "dist/mcp/server.mjs"
  },
  "files": [
    "src",
    "adapters",
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "!src/ui/.qa",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "report": "bun src/cli/main.ts",
    "test": "bun test",
    "check": "bun scripts/check.mjs && node scripts/ui-lint.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:ui": "vite",
    "build": "vite build",
    "preview:ui": "vite preview",
    "typecheck:ui": "tsc --noEmit -p src/ui/tsconfig.json",
    "prepack": "bun run build && bun run build:mcp",
    "build:mcp": "bun build src/mcp/main.ts --target=node --format=esm --outfile=dist/mcp/server.mjs && chmod +x dist/mcp/server.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dicebear/core": "9.4.2",
    "@dicebear/identicon": "9.4.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "embla-carousel-react": "^8",
    "hono": "^4.9.10",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.2.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
