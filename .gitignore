# 敏感与本地状态
.env
.env.*
!.env.example

# 依赖与构建产物
node_modules/
dist/
build/
*.tsbuildinfo

# 运行时数据（数据目录本体不入库；模板见 docs 或 --help）
data/*
# 例外：dsh 会话模式的姓名池是随包分发的静态资产（非运行时数据）
!data/names.json
*.sqlite
*.sqlite-wal
*.sqlite-shm
server.json
export/

# 编辑器与系统
.DS_Store
*.log

# report worker local pointer (per working directory; contains a local path)
.report-pointer
